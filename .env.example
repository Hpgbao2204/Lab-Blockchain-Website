# Canonical public URL (metadata, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://blockchainist.id.vn (or the domain in use); feeds sitemap.xml, robots.txt, OG tags.

# Database. Any Postgres works (Supabase, Neon, …); use the pooled connection string.
# Leave empty for local development: an embedded PGlite database is created under .data/.
# DATABASE_URL=postgres://user:password@host:6543/postgres

# First admin account, created by `npm run db:seed` (only if no admin exists yet).
# Without ADMIN_PASSWORD a temporary one is printed and must be changed at first sign-in.
# For now Bao is the admin; switch to the advisor (dungtrt@uit.edu.vn) once the site is ready.
ADMIN_EMAIL=hpgbao@gmail.com
ADMIN_NAME=Lab Admin
# ADMIN_PASSWORD=

# Uploaded files (PDF, images). Local disk by default (fine for development only).
# UPLOAD_DIR=.data/uploads
# Production: any S3-compatible bucket (Cloudflare R2, Supabase Storage, AWS S3). Browsers upload and
# download directly with short-lived signed URLs; the bucket needs a CORS rule for the site origin.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=blockchainist-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# Monday deadline email (Resend). Without these nothing is sent; the admin page shows a preview.
# RESEND_API_KEY=
# MAIL_FROM="Blockchainist <lab@your-domain>"

# Captcha on the Join form (Cloudflare Turnstile, free). Off when unset.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Protects /api/v1/cron/weekly-digest (the scheduler sends "Authorization: Bearer $CRON_SECRET").
# CRON_SECRET=
