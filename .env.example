# Canonical public URL (metadata, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database. Any Postgres works (Supabase, Neon, …); use the pooled connection string.
# Leave empty for local development: an embedded PGlite database is created under .data/.
# DATABASE_URL=postgres://user:password@host:6543/postgres

# First admin account, created by `npm run db:seed` (only if no admin exists yet).
# Without ADMIN_PASSWORD a temporary one is printed and must be changed at first sign-in.
ADMIN_EMAIL=
ADMIN_NAME=Tran Tuan Dung
# ADMIN_PASSWORD=
