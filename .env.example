# Firebase Web SDK, used by /admin login in the browser
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK, used by Next.js Route Handlers on Vercel
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server-only Firebase email for the sole owner account.
OWNER_EMAIL=

# ORCID Public API credentials, registered by the project team.
ORCID_ID=0000-0003-1156-7072
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Transactional email provider (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Blockchainist <contact@blockchainist.id.vn>
CONTACT_EMAIL=contact@blockchainist.id.vn

# Cloudflare Turnstile keys for the public contact form.
# For local development, use Cloudflare's test keys:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical public URL, used for Turnstile hostname validation.
NEXT_PUBLIC_SITE_URL=https://blockchainist.id.vn
